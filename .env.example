# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
# SOLO servidor. Nunca exponer en el navegador ni subir al repositorio.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# ── Sitio ─────────────────────────────────────────────────
# URL pública del sistema (se usa en los enlaces y el logo de los correos)
NEXT_PUBLIC_SITE_URL=https://regalos.municoinco.cl

# ── Correo (Google Workspace, contraseña de aplicación) ──
GMAIL_USER=inscripciones@municoinco.cl
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=Municipalidad de Coinco - Regalos de Navidad
# Casilla que lee una persona; a ella llegan las respuestas de los apoderados
MAIL_REPLY_TO=inscripciones@municoinco.cl
# Pausa entre correos en envíos masivos (ms)
MAIL_DELAY_MS=1200

# ── Cola de correos ──────────────────────────────────────
# Secreto para llamar a /api/correos/procesar desde un cron (Authorization: Bearer <secreto>)
CRON_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# ── Contacto que se muestra en la portada y en los correos (opcional) ──
NEXT_PUBLIC_CONTACTO_TELEFONO=
NEXT_PUBLIC_CONTACTO_HORARIO=Lunes a viernes, 8:30 a 14:00 hrs
